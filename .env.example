# Copy to .env and fill in — never commit .env

MOFID_USER=your_username_here
MOFID_PASS=your_password_here

# Order defaults (CLI flags override these)
# SIDE=buy                    # buy | sell
# SYMBOL=فولاد
# QUANTITY=1
# PRICE_MODE=auto             # auto | ceiling | floor | reference | fixed
# PRICE=0                     # required when PRICE_MODE=fixed
# TARGET_TIME=08:44:58

# Broker
# BROKER_URL=https://d.easytrader.ir/
# API_BASE_URL=https://api-mts.orbis.easytrader.ir

# Submit burst
# MAX_ORDER_ATTEMPTS=20
# PREOPEN_MAX_ATTEMPTS=30
# SUBMIT_INTERVAL=0.35
# MIN_SUBMIT_INTERVAL=0.32
# VERIFY_ORDER=true

# Token cache (skip login when JWT still valid)
# TOKEN_CACHE=true
# TOKEN_CACHE_PATH=.mofid_token.json
# TOKEN_CACHE_MIN_VALIDITY=120

# Browser
# HEADLESS=false
# CHROME_USER_DATA_DIR=
# INSTANCE_ID=

# Logging
# LOG_LEVEL=INFO
# LOG_FILE=autotrade.log
